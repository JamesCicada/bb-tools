<Window x:Class="BBTools.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="BB Tools · Hunter's Workshop" Icon="Assets/BBTools.png" Width="1040" Height="860" MinWidth="860" MinHeight="680"
 Background="#101216" Foreground="#E8E5DF" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#A0A4AC"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#1A1E24"/><Setter Property="BorderBrush" Value="#303640"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#2B313B"/><Setter Property="Foreground" Value="#ECE8DF"/><Setter Property="BorderBrush" Value="#414956"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#C5A56A"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#E5C381"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#C3A36A"/><Setter Property="Foreground" Value="#171719"/><Setter Property="BorderBrush" Value="#D7BA88"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#11151B"/><Setter Property="Foreground" Value="#E8E5DF"/><Setter Property="CaretBrush" Value="#D7BA88"/><Setter Property="BorderBrush" Value="#424A57"/><Setter Property="Padding" Value="12,9"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="16"/><Setter Property="SelectionBrush" Value="#66532F"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8E5DF"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,16,0,0"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="12,10"/><Setter Property="Foreground" Value="#E8E5DF"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Padding="{TemplateBinding Padding}" Background="#1A1E24"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#3B352A"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#353C47"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#E8E5DF"/><Setter Property="Background" Value="#11151B"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#11151B" BorderBrush="#424A57" BorderThickness="1" CornerRadius="6"><TextBlock Text="⌄" Foreground="#C3A36A" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
   <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,34,0"/>
   <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#1A1E24" BorderBrush="#424A57" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border></Popup>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="#15181D"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#414956" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ProgressBar"><Setter Property="Background" Value="#101318"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="5"/><Setter Property="Margin" Value="0,12,0,18"/></Style>
 </Window.Resources>
 <Grid Background="#101216">
  <Grid.ColumnDefinitions><ColumnDefinition Width="182"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#15181D" BorderBrush="#2B3038" BorderThickness="0,0,1,0" Padding="22,20">
   <DockPanel LastChildFill="False">
    <StackPanel DockPanel.Dock="Top"><Image Source="Assets/BBTools.png" Width="90" Height="90" Stretch="Uniform" Margin="0,-12,0,12" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="BB Tools emblem"/><TextBlock Text="BB TOOLS" Foreground="#D0B179" FontSize="21" FontWeight="Bold"/><TextBlock Text="HUNTER'S WORKSHOP" FontSize="10" Foreground="#8F949F" Margin="0,8,0,24"/>
     <TextBlock Text="WORKSPACE" Style="{StaticResource Caption}"/>
     <Button x:Name="NavPlayer" Content="Player" Tag="Player" Click="Navigate" Background="#3B352A" Margin="0,5,0,8"/>
     <Button x:Name="NavPractice" Content="Combat" Tag="Practice" Click="Navigate" Margin="0,0,0,8"/>
     <Button x:Name="NavItems" Content="Items" Tag="Items" Click="Navigate" Margin="0,0,0,8"/>
     <Button x:Name="NavTravel" Content="Travel" Tag="Travel" Click="Navigate" Margin="0,0,0,8"/>
     <Button x:Name="NavCamera" Content="Camera" Tag="Camera" Click="Navigate" Margin="0,0,0,8"/>
     <Button x:Name="NavWorkshop" Content="Workshop" Tag="Workshop" Click="Navigate" Margin="0,0,0,8"/>
     <Button x:Name="NavSettings" Content="Settings" Tag="Settings" Click="Navigate"/>
     <TextBlock Text="Bloodborne PC" Margin="12,22,0,6" FontSize="12"/><TextBlock Text="CUSA03173 · 1.09" Margin="12,0,0,0" Foreground="#888F9B" FontSize="11"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="VersionLabel" FontSize="10" Foreground="#888F9B"/><TextBlock Text="Local practice companion" FontSize="11" Foreground="#888F9B" Margin="0,6,0,0"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,26,30,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24"><StackPanel><TextBlock x:Name="PageTitle" Text="The hunter" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Shape your next practice run." Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><Border Background="#222831" CornerRadius="12" Padding="14,7" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock x:Name="ConnectionBadge" Text="DISCONNECTED" FontSize="11" Foreground="#C2B89E"/></Border></Grid>
   <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,8,0">
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
      <TextBlock Text="GAME CONNECTION" Style="{StaticResource Caption}"/>
      <TextBox x:Name="ProcessSearch" TextChanged="FilterProcesses" AutomationProperties.Name="Filter processes by name or PID" ToolTip="Filter by name, decimal PID or 0x-prefixed hexadecimal PID" FontSize="13" Padding="10,7" Margin="0,0,0,10"/>
      <TextBlock Text="All processes · filter by name or PID · ★ likely Bloodborne" Style="{StaticResource Caption}"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="Candidates" DisplayMemberPath="Label" MinHeight="40" Margin="0,0,10,0" VerticalContentAlignment="Center" FontSize="13"/>
       <Button Grid.Column="1" x:Name="RefreshButton" Content="Refresh" Click="Refresh" Margin="0,0,10,0"/>
       <Button Grid.Column="2" x:Name="ConnectButton" Content="Connect" Click="Connect" Style="{StaticResource Primary}"/>
      </Grid><TextBlock x:Name="ConnectionHint" Text="Start Bloodborne PC and load a character, then connect." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/>
     </StackPanel></Border>
     <StackPanel x:Name="PlayerPage">
     <Grid x:Name="PlayerControls" IsEnabled="False" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="HEALTH" Style="{StaticResource Caption}"/><TextBlock x:Name="HealthValue" Text="— / —" FontSize="28" FontWeight="SemiBold"/><ProgressBar x:Name="HealthBar" Maximum="1" Foreground="#AE615F"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="HealthInput" Text="1" Margin="0,0,8,0" AutomationProperties.Name="Health amount"/><Button Grid.Column="1" Content="Set HP" Click="SetHealth"/></Grid><Button Content="Restore full health" Click="Heal" Margin="0,10,0,0"/><CheckBox x:Name="KeepHealth" Content="Keep health full"/><TextBlock Text="Refills while alive. Does not prevent one-hit or scripted deaths." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="STAMINA" Style="{StaticResource Caption}"/><TextBlock x:Name="StaminaValue" Text="— / —" FontSize="28" FontWeight="SemiBold"/><ProgressBar x:Name="StaminaBar" Maximum="1" Foreground="#739781"/><CheckBox x:Name="InfiniteStamina" Content="Infinite stamina" Checked="StaminaChanged" Unchecked="StaminaChanged" Margin="0,5,0,0"/><TextBlock Text="Uses the local player's stamina-consumption flag. Turning it off restores its previous setting." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,15,0,0"/><TextBlock Text="Health and stamina controls stop when player validation fails." Foreground="#C3AB7E" FontSize="11" Margin="0,20,0,0"/></StackPanel></Border>
     </Grid>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel x:Name="EchoControls" IsEnabled="False"><Grid><TextBlock Text="BLOOD ECHOES" Style="{StaticResource Caption}"/><TextBlock x:Name="EchoValue" Text="—" HorizontalAlignment="Right" Foreground="#D0B179" FontWeight="SemiBold"/></Grid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="EchoInput" Text="100000" Margin="0,0,10,0" AutomationProperties.Name="Blood Echoes amount"/><Button Grid.Column="1" Content="Set echoes" Click="SetEchoes" Style="{StaticResource Primary}" Margin="0,0,10,0"/><Button Grid.Column="2" Content="+10,000" Click="AddEchoes"/></Grid><TextBlock Text="0–999,999,999 · Changes the current balance. The game may save this value." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel x:Name="StatControls" IsEnabled="False"><Grid><StackPanel><TextBlock Text="CHARACTER ATTRIBUTES" Style="{StaticResource Caption}"/><TextBlock x:Name="LevelValue" Text="Blood Level —" FontSize="20"/></StackPanel><Button Content="Reload current" Click="LoadStats" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid>
      <UniformGrid Columns="3" Margin="0,20,0,0">
       <StackPanel Margin="0,0,12,16"><TextBlock Text="Vitality" Style="{StaticResource Caption}"/><TextBox x:Name="Vitality" AutomationProperties.Name="Vitality"/></StackPanel>
       <StackPanel Margin="0,0,12,16"><TextBlock Text="Endurance" Style="{StaticResource Caption}"/><TextBox x:Name="Endurance" AutomationProperties.Name="Endurance"/></StackPanel>
       <StackPanel Margin="0,0,0,16"><TextBlock Text="Strength" Style="{StaticResource Caption}"/><TextBox x:Name="Strength" AutomationProperties.Name="Strength"/></StackPanel>
       <StackPanel Margin="0,0,12,0"><TextBlock Text="Skill" Style="{StaticResource Caption}"/><TextBox x:Name="Skill" AutomationProperties.Name="Skill"/></StackPanel>
       <StackPanel Margin="0,0,12,0"><TextBlock Text="Bloodtinge" Style="{StaticResource Caption}"/><TextBox x:Name="Bloodtinge" AutomationProperties.Name="Bloodtinge"/></StackPanel>
       <StackPanel><TextBlock Text="Arcane" Style="{StaticResource Caption}"/><TextBox x:Name="Arcane" AutomationProperties.Name="Arcane"/></StackPanel>
      </UniformGrid><TextBlock Text="1–99 per attribute. Blood Level follows the attribute change. Apply while idle, then quit to title and reload your character to refresh derived stats." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,18,0,16"/><Button Content="Apply attributes" Click="ApplyStats" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
     </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="PracticePage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Margin="0,0,0,18"><Expander Header="Saved practice presets" Foreground="#E8E5DF"><StackPanel Margin="0,16,0,0">
       <TextBox x:Name="PresetName" Text="My practice setup" MaxLength="80" AutomationProperties.Name="Preset name"/>
       <Button Content="Save current settings" Click="SavePreset" HorizontalAlignment="Left" Margin="0,10,0,16"/>
       <ComboBox x:Name="PresetPicker" MinHeight="40" AutomationProperties.Name="Saved practice preset"/>
       <WrapPanel Margin="0,12,0,0"><Button Content="Apply selected preset" Click="ApplyPreset" Style="{StaticResource Primary}" Margin="0,0,10,0"/><Button Content="Delete preset" Click="DeletePreset"/></WrapPanel>
       <TextBlock Text="Stores combat toggles, health refill, stamina and applied multipliers locally. Apply explicitly after connecting. Matching names replace saved presets; character stats and Echoes balances are excluded." Style="{StaticResource Caption}" Margin="0,12,0,0"/>
      </StackPanel></Expander></Border>
      <Border Style="{StaticResource Card}"><StackPanel x:Name="PracticeControls" IsEnabled="False">
       <TextBlock Text="COMBAT &amp; STEALTH" Style="{StaticResource Caption}"/>
       <CheckBox x:Name="GodMode" Content="God mode" Tag="GodMode" Checked="FlagChanged" Unchecked="FlagChanged"/>
       <TextBlock Text="Blocks damage and prevents ordinary health-based death." Style="{StaticResource Caption}" Margin="20,8,0,4"/>
       <CheckBox x:Name="OneShot" Content="One-shot kills" Tag="OneShot" Checked="FlagChanged" Unchecked="FlagChanged"/>
       <TextBlock Text="Use the game's Player Exterminate flag. Boss phase transitions may still apply." Style="{StaticResource Caption}" Margin="20,8,0,4"/>
       <CheckBox x:Name="Stealth" Content="Invisible to enemies" Tag="Stealth" Checked="FlagChanged" Unchecked="FlagChanged"/>
       <CheckBox x:Name="Silent" Content="Silent footsteps" Tag="Silence" Checked="FlagChanged" Unchecked="FlagChanged"/>
       <CheckBox x:Name="NoAi" Content="Disable enemy AI" Tag="NoAi" Checked="FlagChanged" Unchecked="FlagChanged"/>
       <TextBlock Text="Stops the engine's character AI updates. Enemies can still be affected by physics and scripted events." Style="{StaticResource Caption}" Margin="20,8,0,4"/>
       <CheckBox x:Name="NoFallDamage" Content="No fall damage" Tag="NoFallDamage" Checked="FlagChanged" Unchecked="FlagChanged"/>
       <CheckBox x:Name="InfiniteItems" Content="Infinite consumables &amp; bullets" Tag="InfiniteItems" Checked="FlagChanged" Unchecked="FlagChanged"/>
       <Separator Margin="0,16"/>
       <TextBlock Text="PLAYER MULTIPLIERS" Style="{StaticResource Caption}"/>
       <UniformGrid Columns="2" Margin="0,8,0,12">
        <StackPanel Margin="0,0,12,0"><TextBlock Text="Outgoing damage" Style="{StaticResource Caption}"/><TextBox x:Name="DamageMultiplier" Text="1" AutomationProperties.Name="Damage multiplier"/></StackPanel>
        <StackPanel><TextBlock Text="Echoes from enemies" Style="{StaticResource Caption}"/><TextBox x:Name="EchoesMultiplier" Text="1" AutomationProperties.Name="Echoes reward multiplier"/></StackPanel>
       </UniformGrid>
       <Button Content="Apply multipliers" Click="ApplyMultipliers" HorizontalAlignment="Left"/>
       <TextBlock Text="0.1–100×. Set both to 1 to restore. Uses a player-only effect; does not scale spending or bloodstain recovery. Selections resume after loading." Style="{StaticResource Caption}" Margin="0,12,0,12"/>
       <TextBlock Text="Selections stay on through loading screens and warps. They resume when the player validates. Disconnecting clears selections; turning them off restores the settings they replaced." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,24,0,16"/>
       <Button Content="Turn off practice toggles" Click="TurnOffFeatures" HorizontalAlignment="Left"/>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="ItemsPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
       <TextBlock Text="SPAWN ITEM" Style="{StaticResource Caption}"/>
       <TextBlock Text="Choose a common item, or enter a base item ID and category." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,16"/>
       <TextBlock Margin="0,0,0,12"><Hyperlink NavigateUri="https://www.bloodborne-wiki.com/2018/01/datamined-item-ids.html" RequestNavigate="OpenReference" Foreground="#D0B179">Bloodborne Wiki · Datamined item IDs ↗</Hyperlink></TextBlock>
       <TextBlock Margin="0,0,0,12"><Hyperlink NavigateUri="https://www.bloodborne-wiki.com/2018/01/datamined-weapon-model-item-ids.html" RequestNavigate="OpenReference" Foreground="#D0B179">Weapon IDs ↗</Hyperlink></TextBlock>
       <StackPanel x:Name="ItemControls" IsEnabled="False">
       <CheckBox x:Name="WikiHexId" Content="Wiki hexadecimal Item ID (includes category)" Margin="0,0,0,12"/>
       <TextBlock Text="Decimal mode: base ID + selected category. Wiki mode: paste the full hexadecimal Item ID, e.g. 400003E8. A 0x prefix also selects hexadecimal mode." Style="{StaticResource Caption}"/>
       <ComboBox x:Name="ItemPicker" DisplayMemberPath="Label" MinHeight="40" SelectionChanged="ItemSelected"/>
       <Grid Margin="0,16,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0"><TextBlock Text="Base item ID" Style="{StaticResource Caption}"/><TextBox x:Name="ItemId" Text="1000" AutomationProperties.Name="Base item ID"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Category" Style="{StaticResource Caption}"/><ComboBox x:Name="ItemCategory" SelectedIndex="0" MinHeight="42"><ComboBoxItem Content="Goods" Tag="1073741824"/><ComboBoxItem Content="Weapon" Tag="0"/><ComboBoxItem Content="Armor" Tag="268435456"/><ComboBoxItem Content="Accessory" Tag="536870912"/></ComboBox></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Quantity" Style="{StaticResource Caption}"/><TextBox x:Name="ItemQuantity" Text="1" AutomationProperties.Name="Item quantity"/></StackPanel>
       </Grid><Button Content="Spawn item" Click="SpawnItem" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
       <TextBlock Text="Goods: 1–99. Equipment: 1. Custom IDs must exist in your game. The game handles inventory limits and storage; check your inventory after the request completes." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0"/>
      </StackPanel></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="WorkshopPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel x:Name="MenuControls" IsEnabled="False">
       <TextBlock Text="WORKSHOP MENUS" Style="{StaticResource Caption}"/>
       <ComboBox x:Name="MenuPicker" DisplayMemberPath="Label" MinHeight="40"/>
       <Button Content="Open selected menu" Click="OpenRemoteMenu" HorizontalAlignment="Left" Margin="0,12,0,0"/>
       <TextBlock Text="Level up, fortify, repair, storage, blood gems and Caryll runes. Close other menus first and use while idle. Normal Echoes and material costs apply. Close normally in the game." Style="{StaticResource Caption}" Margin="0,12,0,0"/>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="TravelPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel x:Name="WarpControls" IsEnabled="False"><TextBlock Text="WARP TO LAMP" Style="{StaticResource Caption}"/>
       <TextBox x:Name="LampSearch" TextChanged="FilterLamps" ToolTip="Filter lamps by name or DLC" AutomationProperties.Name="Search lamps" Margin="0,8,0,0"/>
       <ComboBox x:Name="LampPicker" DisplayMemberPath="Label" MinHeight="40" Margin="0,10,0,16"/>
       <Button Content="Warp to selected lamp" Click="Warp" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
       <TextBlock Text="All 45 named base-game and DLC destinations. Boss-arena lamps do not reset bosses or unlock quest flags. Use the chalice altar controls below for generated dungeons. Warp while idle." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel x:Name="ChaliceControls" IsEnabled="False">
       <TextBlock Text="CHALICE DUNGEON TRAVEL" Style="{StaticResource Caption}"/>
       <ComboBox x:Name="ChalicePicker" DisplayMemberPath="Label" MinHeight="40"/>
       <ComboBox x:Name="ChaliceLampPicker" DisplayMemberPath="Label" MinHeight="40" Margin="0,10,0,0"/>
       <WrapPanel Margin="0,12,0,0"><Button Content="Refresh altars" Click="RefreshChalices" Margin="0,0,10,0"/><Button Content="Travel to chalice lamp" Click="OpenChaliceTravel" Style="{StaticResource Primary}"/></WrapPanel>
       <TextBlock Text="Start from Hunter's Dream. Choose an existing altar and one of its unlocked layer lamps. Uses that character's generated dungeon and progress. Empty rituals and locked lamps are rejected; this does not create dungeons or unlock lamps." Style="{StaticResource Caption}" Margin="0,12,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel x:Name="BossControls" IsEnabled="False">
       <TextBlock Text="BOSS ENTRANCES" Style="{StaticResource Caption}"/>
       <ComboBox x:Name="BossPicker" DisplayMemberPath="Label" MinHeight="40"/>
       <WrapPanel Margin="0,12,0,0"><Button Content="1 · Travel to area" Click="TravelBossArea" Margin="0,0,10,0"/><Button Content="2 · Go to entrance" Click="GoToBoss" Style="{StaticResource Primary}"/></WrapPanel>
       <TextBlock Text="22 boss entrances, including all five DLC bosses. Travel to the area, wait for loading, then go to the entrance. This places you outside the fog; it does not revive bosses, open doors or change quest flags." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel x:Name="LocationControls" IsEnabled="False">
       <TextBlock Text="SAVED LOCATIONS" Style="{StaticResource Caption}"/>
       <TextBox x:Name="LocationName" Text="Practice spot" MaxLength="80" AutomationProperties.Name="Location name"/>
       <Button Content="Save current location" Click="SaveLocation" HorizontalAlignment="Left" Margin="0,10,0,16"/>
       <TextBlock Text="Search saved locations" Style="{StaticResource Caption}"/>
       <TextBox x:Name="LocationSearch" TextChanged="SearchLocations" AutomationProperties.Name="Search saved locations" ToolTip="Search by name or map" Margin="0,0,0,10"/>
       <ComboBox x:Name="LocationPicker" DisplayMemberPath="Label" MinHeight="40"/>
       <WrapPanel Margin="0,12,0,0"><Button Content="Restore location" Click="RestoreLocation" Style="{StaticResource Primary}" Margin="0,0,10,0"/><Button Content="Delete selected" Click="DeleteLocation"/></WrapPanel>
       <TextBlock Text="Stores named positions in the local library between app sessions. Search by name or map. Restore within the same loaded map; travel to its lamp first when elsewhere." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0"/>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="CameraPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="FIELD OF VIEW" Style="{StaticResource Caption}"/>
       <TextBlock Text="Vertical FOV" FontSize="20"/>
       <TextBlock x:Name="FovValue" Text="43°" Foreground="#D0B179" FontSize="26" Margin="0,12,0,8"/>
       <Slider x:Name="FovSlider" Minimum="38" Maximum="120" Value="43" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FovChanged" AutomationProperties.Name="Vertical field of view"/>
       <CheckBox x:Name="FovEnabled" Content="Override camera FOV" Checked="FovToggled" Unchecked="FovToggled"/>
       <Button Content="Restore original FOV" Click="ResetFov" HorizontalAlignment="Left" Margin="0,16,0,0"/>
       <TextBlock x:Name="FovHint" Text="Connect to a loaded character. 38–120° vertical. Wide angles automatically remove the camera clamp in memory; no external patch is required. Disabling restores the clamp if this app changed it." Style="{StaticResource Caption}" Margin="0,16,0,0"/>
       <TextBlock Text="Uses camera parameter rows and preserves their individual original values. Changes ease in through the game camera and resume after loads. Disable or disconnect to restore. Camera angles are vertical, not horizontal." Style="{StaticResource Caption}"/>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
       <TextBlock Text="ABOUT &amp; UPDATES" Style="{StaticResource Caption}"/>
       <TextBlock x:Name="AboutVersion" FontSize="22" FontWeight="SemiBold"/>
       <TextBlock x:Name="UpdateStatus" Text="Use Check for updates below to look for a newer stable GitHub release." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/>
       <TextBlock Text="Checks run only when requested. Downloads open on GitHub; nothing is installed automatically." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="CONNECTION" Style="{StaticResource Caption}"/>
       <CheckBox x:Name="AutoConnect" Content="Find the best game process and connect automatically" Checked="AutoConnectChanged" Unchecked="AutoConnectChanged" Margin="0,8,0,16"/>
       <TextBlock Text="Checks every three seconds while disconnected. Prefers a loaded character after verifying the game image. Reconnects when the engine restarts. Manual disconnect pauses automatic connection until you reconnect or toggle this setting." Foreground="{StaticResource Muted}" FontSize="12"/>
      </StackPanel></Border>
     <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="SAVE BACKUP" Style="{StaticResource Caption}"/><TextBlock Text="Keep a copy before changing your character."/><TextBlock Text="Close the game before creating a backup." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" x:Name="BackupButton" Content="Back up saves…" Click="Backup" VerticalAlignment="Center"/></Grid></Border>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="2" Background="#1A1E24" CornerRadius="6" Padding="12" Margin="0,16,8,0"><TextBlock x:Name="Status" Text="Ready. Connect to a loaded Bloodborne PC 1.09 session." Foreground="#BBC1CB" FontSize="12"/></Border>
   <Border Grid.Row="3" BorderBrush="#2B3038" BorderThickness="0,1,0,0" Margin="0,12,8,0" Padding="0,10,0,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock FontSize="12" Foreground="#A0A4AC" VerticalAlignment="Center" Margin="0,0,8,0"><Run Text="Made with "/><Run Text="🖤" FontFamily="Segoe UI Emoji"/><Run Text=" By James Cicada"/></TextBlock>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button Content="GitHub ↗" Click="OpenGitHub" Padding="10,7" FontSize="12" Margin="0,0,8,0"/>
      <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckForUpdates" Padding="10,7" FontSize="12"/>
      <Button x:Name="UpdateReleaseButton" Content="View release ↗" Click="OpenUpdateRelease" Style="{StaticResource Primary}" Visibility="Collapsed" Padding="10,7" FontSize="12" Margin="8,0,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
