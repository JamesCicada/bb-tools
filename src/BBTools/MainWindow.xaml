       </Trigger>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="TabSurface" Property="Background" Value="#242A33" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
