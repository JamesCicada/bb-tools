          <Slider x:Name="PhotoExposure" Minimum="-2" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="PhotoAdjustmentChanged" />
          <TextBlock Text="Contrast" Style="{StaticResource Caption}" />
          <Slider x:Name="PhotoContrast" Minimum="0.5" Maximum="1.5" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="PhotoAdjustmentChanged" />
          <TextBlock Text="Saturation" Style="{StaticResource Caption}" />
          <Slider x:Name="PhotoSaturation" Minimum="0" Maximum="2" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="PhotoAdjustmentChanged" />
          <TextBlock Text="Vignette" Style="{StaticResource Caption}" />
          <Slider x:Name="PhotoVignette" Minimum="0" Maximum="0.8" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="PhotoAdjustmentChanged" />
          <TextBlock x:Name="PhotoAdjustmentsSummary" Style="{StaticResource Caption}" Margin="0,10,0,10" />
          <WrapPanel>
           <Button x:Name="SavePhotoEditsButton" IsEnabled="False" Content="Save filtered copy" Click="SavePhotoEdits" Margin="0,0,10,10" />
           <Button Content="Reset filters" Click="ResetPhotoAdjustments" Margin="0,0,0,10" />
          </WrapPanel>
          <Image x:Name="PhotoPreview" MaxHeight="260" Stretch="Uniform" HorizontalAlignment="Left" />
          <TextBlock x:Name="PhotoCaptureSummary" Text="No photo captured this session." Foreground="#D0B179" Margin="0,12,0,0" />
         </StackPanel>
        </Expander>
        <Expander Header="Save folder and defaults" Foreground="#E8E5DF" Margin="0,14,0,0">
         <StackPanel>
          <TextBlock x:Name="PhotoFolderLabel" Style="{StaticResource Caption}" Margin="0,12,0,0" />
          <WrapPanel Margin="0,12,0,0">
           <Button Content="Choose photo folder" Click="ChoosePhotoFolder" Margin="0,0,10,10" />
           <Button Content="Save photo defaults" Click="SavePhotoDefaults" Margin="0,0,0,10" />
          </WrapPanel>
         </StackPanel>
        </Expander>
        <TextBlock Text="Lossless PNG at the displayed game resolution. Rebind controls in Settings. Exit restores camera, hunter movement and HUD; loading/death ends photo mode." Style="{StaticResource Caption}" Margin="0,16,0,0" />
       </StackPanel>
      </Border>
     </StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
      <TabControl x:Name="SettingsSections">
       <TabItem Header="Connection">
        <StackPanel>
         <Border x:Name="ConnectionPanel" Style="{StaticResource Card}" Margin="0,0,0,18">
          <StackPanel>
           <TextBlock Text="GAME CONNECTION" Style="{StaticResource Caption}" />
           <TextBox x:Name="ProcessSearch" TextChanged="FilterProcesses" AutomationProperties.Name="Filter processes by name or PID" ToolTip="Filter by name, decimal PID or 0x-prefixed hexadecimal PID" FontSize="13" Padding="10,7" Margin="0" Visibility="Collapsed" />
           <TextBlock Text="All processes · filter by name or PID · ★ likely Bloodborne" Style="{StaticResource Caption}" />
           <Grid>
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="*" />
             <ColumnDefinition Width="Auto" />
             <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="Candidates" DisplayMemberPath="Label" MinHeight="40" Margin="0,0,10,0" VerticalContentAlignment="Center" FontSize="13" local:PickerSearch.Target="ProcessSearch" />
            <Button Grid.Column="1" x:Name="RefreshButton" Content="Refresh" Click="Refresh" Margin="0,0,10,0" />
            <Button Grid.Column="2" x:Name="ConnectButton" Content="Connect" Click="Connect" Style="{StaticResource Primary}" />
           </Grid>
           <TextBlock x:Name="ConnectionHint" Text="Start Bloodborne PC and load a character, then connect." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0" />
          </StackPanel>
         </Border>
         <Border Style="{StaticResource Card}" Margin="0,0,0,18">
          <StackPanel>
           <TextBlock Text="SUPPORTED RUNTIMES" Style="{StaticResource Caption}" />
           <TextBlock Text="Bloodborne PC and shadPS4 · CUSA03173 1.09. Tested and confirmed. Select the game process or use automatic connection. Game-image and player validation remain required." Style="{StaticResource Caption}" Margin="0,10,0,0" />
          </StackPanel>
         </Border>
         <Border Style="{StaticResource Card}" Margin="0,0,0,18">
          <StackPanel>
           <TextBlock Text="CONNECTION" Style="{StaticResource Caption}" />
           <CheckBox x:Name="AutoConnect" Content="Find the best game process and connect automatically" Checked="AutoConnectChanged" Unchecked="AutoConnectChanged" Margin="0,8,0,16" />
           <TextBlock Text="Checks every three seconds while disconnected. Prefers a loaded character after verifying the game image. Reconnects when the engine restarts. Manual disconnect pauses automatic connection until you reconnect or toggle this setting." Foreground="{StaticResource Muted}" FontSize="12" />
          </StackPanel>
         </Border>
        </StackPanel>
       </TabItem>
       <TabItem Header="Preferences">
        <StackPanel>
         <Border Style="{StaticResource Card}" Margin="0,0,0,18">
          <StackPanel>
           <TextBlock Text="DISCORD RICH PRESENCE" Style="{StaticResource Caption}" />
           <CheckBox x:Name="DiscordPresenceEnabled" Content="Show Bloodborne activity on Discord" IsChecked="True" Checked="DiscordPresenceChanged" Unchecked="DiscordPresenceChanged" Margin="0,4,0,0" />
           <TextBlock Text="Shares only that Bloodborne is running and its runtime. No character name, location or stats. Clears when disconnected or disabled. Discord desktop must be running." Style="{StaticResource Caption}" Margin="0,10,0,0" />
           <TextBlock x:Name="DiscordPresenceStatus" Text="Waiting for a connected game." Foreground="#D0B179" />
          </StackPanel>
         </Border>
         <Border Style="{StaticResource Card}" Margin="0,0,0,18">
          <StackPanel>
           <TextBlock Text="STARTUP SETTINGS" Style="{StaticResource Caption}" />
           <CheckBox x:Name="StartupFov" Content="Apply saved FOV automatically when a character loads" />
           <Button Content="Save current FOV as startup default" Click="SaveStartupFov" HorizontalAlignment="Left" Margin="0,12,0,0" />
           <TextBlock x:Name="StartupSummary" Style="{StaticResource Caption}" Margin="0,12,0,0" />
           <TextBlock Text="Startup presets apply once per connection when a living character is ready. Choose the preset in Combat. Stats, Echoes balances, spawning, warps and boss revival never run automatically." Style="{StaticResource Caption}" />
          </StackPanel>
         </Border>
        </StackPanel>
       </TabItem>
       <TabItem Header="Hotkeys">
        <StackPanel>
         <Border Style="{StaticResource Card}" Margin="0,0,0,18">
          <StackPanel>
           <TextBlock Text="PRACTICE HOTKEYS" Style="{StaticResource Caption}" />
           <CheckBox x:Name="HotkeysEnabled" Content="Enable practice hotkeys" />
           <TextBlock Text="Shortcut modifier (choose None for F-keys alone)" Style="{StaticResource Caption}" Margin="0,12,0,4" />
           <ComboBox x:Name="HotkeyModifiers" MinHeight="40" />
           <TextBlock x:Name="HotkeySummary" TextWrapping="Wrap" Foreground="#D0B179" Margin="0,8,0,0" />
           <UniformGrid Columns="5" Margin="0,12,0,12">
            <StackPanel Margin="0,0,8,0">
             <TextBlock Text="Heal" Style="{StaticResource Caption}" />
             <ComboBox x:Name="HotkeyHeal" MinHeight="40" />
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
             <TextBlock Text="God mode" Style="{StaticResource Caption}" />
             <ComboBox x:Name="HotkeyGod" MinHeight="40" />
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
             <TextBlock Text="Save spot" Style="{StaticResource Caption}" />
             <ComboBox x:Name="HotkeySave" MinHeight="40" />
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
             <TextBlock Text="Restore" Style="{StaticResource Caption}" />
             <ComboBox x:Name="HotkeyRestore" MinHeight="40" />
            </StackPanel>
            <StackPanel>
             <TextBlock Text="Boss retry" Style="{StaticResource Caption}" />
             <ComboBox x:Name="HotkeyRetry" MinHeight="40" />
            </StackPanel>
           </UniformGrid>
           <Button Content="Apply hotkeys" Click="SaveHotkeys" HorizontalAlignment="Left" />
           <TextBlock Text="Active only while the connected game or BB Tools has focus; ignored while typing in the app. Save/restore uses a Quick bookmark. Retry resets and reloads the selected boss from any area. Press the modifier shown above plus the chosen F-key. These keys also reach the game; avoid conflicting game bindings. Duplicate shortcuts are rejected." Style="{StaticResource Caption}" Margin="0,12,0,0" />
          </StackPanel>
         </Border>
        </StackPanel>
       </TabItem>
       <TabItem Header="Library">
        <StackPanel>
         <Border Style="{StaticResource Card}" Margin="0,0,0,18">
          <StackPanel>
           <TextBlock Text="SAVED LIBRARY" Style="{StaticResource Caption}" />
           <WrapPanel>
            <Button Content="Export library" Click="ExportLibrary" Margin="0,0,10,10" />
            <Button Content="Import library" Click="ImportLibrary" Margin="0,0,10,10" />
            <Button Content="Back up database" Click="BackupLibrary" Margin="0,0,0,10" />
           </WrapPanel>
           <TextBlock Text="Exports presets, locations and item favorites. Import validates everything before committing; matching names are replaced. Importing never applies presets, spawns items or warps. Database backup is a consistent SQLite snapshot." Style="{StaticResource Caption}" />
          </StackPanel>
         </Border>
        </StackPanel>
       </TabItem>
       <TabItem Header="Backups">
        <StackPanel>
         <Border Style="{StaticResource Card}" Margin="0,0,0,18">
          <StackPanel>
           <TextBlock Text="SAVE BACKUP HISTORY &amp; RESTORE" Style="{StaticResource Caption}" />
           <Button Content="Choose backup folder" Click="ChooseBackupFolder" HorizontalAlignment="Left" Margin="0,0,0,12" />
           <ComboBox x:Name="BackupHistory" MinHeight="40" AutomationProperties.Name="Save backup history" />
           <Button x:Name="RestoreBackupButton" Content="Restore selected backup to save folder…" Click="RestoreSaveBackup" HorizontalAlignment="Left" Margin="0,12,0,0" />
           <TextBlock Text="Close the game and launcher first. Restore verifies paths, sizes and CRC checksums, then keeps a recovery ZIP and the previous save folder before replacing the selected folder. Select the actual save folder, not the game installation." Style="{StaticResource Caption}" Margin="0,12,0,0" />
          </StackPanel>
         </Border>
         <Border Style="{StaticResource Card}">
          <Grid>
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
           </Grid.ColumnDefinitions>
           <StackPanel Margin="0,0,18,0">
            <TextBlock Text="SAVE BACKUP" Style="{StaticResource Caption}" />
            <TextBlock Text="Keep a copy before changing your character." />
            <TextBlock Text="Close the game before creating a backup." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
           </StackPanel>
           <Button Grid.Column="1" x:Name="BackupButton" Content="Back up saves…" Click="Backup" VerticalAlignment="Center" />
          </Grid>
         </Border>
        </StackPanel>
       </TabItem>
       <TabItem Header="About">
        <StackPanel>
         <Border Style="{StaticResource Card}" Margin="0,0,0,18">
          <StackPanel>
           <TextBlock Text="ABOUT &amp; UPDATES" Style="{StaticResource Caption}" />
           <Button Content="Export diagnostics" Click="ExportDiagnostics" HorizontalAlignment="Left" Margin="0,0,0,12" />
           <TextBlock x:Name="AboutVersion" FontSize="22" FontWeight="SemiBold" />
           <TextBlock x:Name="UpdateStatus" Text="Use Check for updates below to look for a newer stable GitHub release." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0" />
           <TextBlock Text="Checks run only when requested. Downloads open on GitHub; nothing is installed automatically." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
          </StackPanel>
         </Border>
        </StackPanel>
       </TabItem>
      </TabControl>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="2" Background="#1A1E24" CornerRadius="6" Padding="12" Margin="0,16,8,0">
    <TextBlock x:Name="Status" Text="Ready. Connect to a loaded Bloodborne PC 1.09 session." Foreground="#BBC1CB" FontSize="12" />
   </Border>
   <Border Grid.Row="3" BorderBrush="#2B3038" BorderThickness="0,1,0,0" Margin="0,12,8,0" Padding="0,10,0,0">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
     </Grid.ColumnDefinitions>
     <TextBlock FontSize="12" Foreground="#A0A4AC" VerticalAlignment="Center" Margin="0,0,8,0">
      <Run Text="Made with " />
      <Run Text="🖤" FontFamily="Segoe UI Emoji" />
      <Run Text=" By James Cicada" />
     </TextBlock>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button Content="GitHub ↗" Click="OpenGitHub" Padding="10,7" FontSize="12" Margin="0,0,8,0" />
      <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckForUpdates" Padding="10,7" FontSize="12" />
      <Button x:Name="UpdateReleaseButton" Content="View release ↗" Click="OpenUpdateRelease" Style="{StaticResource Primary}" Visibility="Collapsed" Padding="10,7" FontSize="12" Margin="8,0,0,0" />
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
