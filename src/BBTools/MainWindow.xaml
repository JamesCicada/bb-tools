<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:BBTools" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="BBTools.MainWindow" Title="BB Tools · Hunter's Workshop" Icon="Assets/BBTools.png" Width="1040" Height="860" MinWidth="860" MinHeight="680" Background="#101216" Foreground="#E8E5DF" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#A0A4AC" />
  <Style TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap" />
   <Setter Property="Foreground" Value="{StaticResource Muted}" />
   <Setter Property="FontSize" Value="12" />
   <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="#1A1E24" />
   <Setter Property="BorderBrush" Value="#303640" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="CornerRadius" Value="12" />
   <Setter Property="Padding" Value="18" />
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#2B313B" />
   <Setter Property="Foreground" Value="#ECE8DF" />
   <Setter Property="BorderBrush" Value="#414956" />
   <Setter Property="Padding" Value="16,10" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Surface" Property="BorderBrush" Value="#C5A56A" />
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Surface" Property="BorderBrush" Value="#E5C381" />
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.4" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#C3A36A" />
   <Setter Property="Foreground" Value="#171719" />
   <Setter Property="BorderBrush" Value="#D7BA88" />
   <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#11151B" />
   <Setter Property="Foreground" Value="#E8E5DF" />
   <Setter Property="CaretBrush" Value="#D7BA88" />
   <Setter Property="BorderBrush" Value="#424A57" />
   <Setter Property="Padding" Value="12,9" />
   <Setter Property="VerticalContentAlignment" Value="Center" />
   <Setter Property="FontSize" Value="16" />
   <Setter Property="SelectionBrush" Value="#66532F" />
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#E8E5DF" />
   <Setter Property="VerticalContentAlignment" Value="Center" />
   <Setter Property="Margin" Value="0,16,0,0" />
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Padding" Value="12,10" />
   <Setter Property="Foreground" Value="#E8E5DF" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Item" Padding="{TemplateBinding Padding}" Background="#1A1E24">
       <ContentPresenter />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Item" Property="Background" Value="#3B352A" />
       </Trigger>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="Item" Property="Background" Value="#353C47" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#E8E5DF" />
   <Setter Property="Background" Value="#11151B" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid>
       <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <Border Background="#11151B" BorderBrush="#424A57" BorderThickness="1" CornerRadius="6">
           <TextBlock Text="⌄" Foreground="#C3A36A" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
          </Border>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>
       <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,34,0" />
       <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
        <Border Background="#1A1E24" BorderBrush="#424A57" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
         <StackPanel>
          <TextBox x:Name="PickerFilter" Text="{Binding Path=(local:PickerSearch.Text), RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search choices" ToolTip="Search these choices" Margin="6" MinHeight="36" />
          <ScrollViewer MaxHeight="260">
           <ItemsPresenter />
          </ScrollViewer>
         </StackPanel>
        </Border>
       </Popup>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.55" />
       </Trigger>
       <Trigger Property="local:PickerSearch.Target" Value="{x:Null}">
        <Setter TargetName="PickerFilter" Property="Visibility" Value="Collapsed" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="8" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ScrollBar">
      <Grid Background="#15181D">
       <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
        <Track.DecreaseRepeatButton>
         <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
         <Thumb>
          <Thumb.Template>
           <ControlTemplate TargetType="Thumb">
            <Border Background="#414956" CornerRadius="4" Margin="1" />
           </ControlTemplate>
          </Thumb.Template>
         </Thumb>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
         <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
        </Track.IncreaseRepeatButton>
       </Track>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ProgressBar">
   <Setter Property="Background" Value="#101318" />
   <Setter Property="BorderThickness" Value="0" />
   <Setter Property="Height" Value="5" />
   <Setter Property="Margin" Value="0,12,0,18" />
  </Style>
  <Style TargetType="TabControl">
   <Setter Property="Background" Value="Transparent" />
   <Setter Property="BorderThickness" Value="0" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabControl">
      <Grid KeyboardNavigation.TabNavigation="Local">
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
       </Grid.RowDefinitions>
       <TabPanel IsItemsHost="True" Margin="0,0,0,16" />
       <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="#ADB5C2" />
   <Setter Property="Padding" Value="14,9" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabItem">
      <Border x:Name="TabSurface" BorderBrush="Transparent" BorderThickness="0,0,0,2" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,8,0">
       <ContentPresenter ContentSource="Header" />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True">
        <Setter Property="Foreground" Value="#E5C381" />
        <Setter TargetName="TabSurface" Property="BorderBrush" Value="#C3A36A" />
        <Setter TargetName="TabSurface" Property="Background" Value="#1A1E24" />
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="TabSurface" Property="Background" Value="#242A33" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid Background="#101216">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" />
   <RowDefinition Height="*" />
  </Grid.RowDefinitions>
  <Border Background="#15181D" BorderBrush="#2B3038" BorderThickness="0,0,0,1" Padding="24,12,24,0">
   <StackPanel>
    <Grid Margin="0,0,0,10">
     <StackPanel Orientation="Horizontal">
      <Image Source="Assets/BBTools.png" Width="36" Height="36" Margin="0,0,10,0" />
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="BB TOOLS" FontSize="18" FontWeight="Bold" Foreground="#D0B179" />
       <TextBlock x:Name="VersionLabel" FontSize="10" Foreground="#969DA8" />
      </StackPanel>
      <TextBlock Text="Bloodborne PC · shadPS4" FontSize="12" Foreground="#969DA8" Margin="20,0,0,0" VerticalAlignment="Center" />
     </StackPanel>
     <Button Tag="Settings" Click="Navigate" ToolTip="Manage game connection in Settings" Padding="12,7" HorizontalAlignment="Right" VerticalAlignment="Top">
      <StackPanel>
       <TextBlock x:Name="ConnectionBadge" Text="DISCONNECTED" FontSize="11" Foreground="#C2B89E" />
       <TextBlock Text="Manage connection ↗" FontSize="10" Foreground="#A0A4AC" Margin="0,3,0,0" />
      </StackPanel>
     </Button>
    </Grid>
    <UniformGrid Columns="8" Margin="0,0,0,10">
     <Button x:Name="NavPlayer" FontSize="13" Padding="10,8" Content="Player" Tag="Player" Click="Navigate" Background="#3B352A" Margin="0,0,6,0" />
     <Button x:Name="NavPractice" FontSize="13" Padding="10,8" Content="Combat" Tag="Practice" Click="Navigate" Margin="0,0,6,0" />
     <Button x:Name="NavTarget" FontSize="13" Padding="10,8" Content="Enemies" Tag="Target" Click="Navigate" Margin="0,0,6,0" />
     <Button x:Name="NavItems" FontSize="13" Padding="10,8" Content="Items" Tag="Items" Click="Navigate" Margin="0,0,6,0" />
     <Button x:Name="NavTravel" FontSize="13" Padding="10,8" Content="Travel" Tag="Travel" Click="Navigate" Margin="0,0,6,0" />
     <Button x:Name="NavCamera" FontSize="13" Padding="10,8" Content="Camera" Tag="Camera" Click="Navigate" Margin="0,0,6,0" />
     <Button x:Name="NavWorkshop" FontSize="13" Padding="10,8" Content="Workshop" Tag="Workshop" Click="Navigate" Margin="0,0,6,0" />
     <Button x:Name="NavSettings" FontSize="13" Padding="10,8" Content="Settings" Tag="Settings" Click="Navigate" Margin="0,0,6,0" />
    </UniformGrid>
    <Button x:Name="NavPhoto" FontSize="13" Padding="12,8" Content="Photo studio" Tag="Photo" Click="Navigate" Margin="0,0,0,6" Visibility="Collapsed" />
   </StackPanel>
  </Border>
  <Grid Margin="24,16,24,14" Grid.Row="1">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition Height="*" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
   </Grid.RowDefinitions>
   <Grid Margin="0,0,0,16">
    <StackPanel>
     <TextBlock x:Name="PageTitle" Text="The hunter" FontSize="25" FontWeight="SemiBold" />
     <TextBlock x:Name="PageSubtitle" Text="Shape your next practice run." Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
    </StackPanel>
   </Grid>
   <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,8,0">
     <StackPanel x:Name="PlayerPage">
      <Grid x:Name="PlayerControls" IsEnabled="False" Margin="0,0,0,18">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
       </Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}">
        <StackPanel>
         <TextBlock Text="HEALTH" Style="{StaticResource Caption}" />
         <TextBlock x:Name="HealthValue" Text="— / —" FontSize="28" FontWeight="SemiBold" />
         <ProgressBar x:Name="HealthBar" Maximum="1" Foreground="#AE615F" />
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*" />
           <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="HealthInput" Text="1" Margin="0,0,8,0" AutomationProperties.Name="Health amount" />
          <Button Grid.Column="1" Content="Set HP" Click="SetHealth" />
         </Grid>
         <Button Content="Restore full health" Click="Heal" Margin="0,10,0,0" />
         <CheckBox x:Name="KeepHealth" Content="Keep health full" />
         <TextBlock Text="Refills while alive. Does not prevent one-hit or scripted deaths." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" />
        </StackPanel>
       </Border>
       <Border Grid.Column="2" Style="{StaticResource Card}">
        <StackPanel>
         <TextBlock Text="STAMINA" Style="{StaticResource Caption}" />
         <TextBlock x:Name="StaminaValue" Text="— / —" FontSize="28" FontWeight="SemiBold" />
         <ProgressBar x:Name="StaminaBar" Maximum="1" Foreground="#739781" />
         <CheckBox x:Name="InfiniteStamina" Content="Infinite stamina" Checked="StaminaChanged" Unchecked="StaminaChanged" Margin="0,5,0,0" />
         <TextBlock Text="Uses the local player's stamina-consumption flag. Turning it off restores its previous setting." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,15,0,0" />
         <TextBlock Text="Health and stamina controls stop when player validation fails." Foreground="#C3AB7E" FontSize="11" Margin="0,20,0,0" />
        </StackPanel>
       </Border>
      </Grid>
      <Border Style="{StaticResource Card}" Margin="0,0,0,18">
       <StackPanel x:Name="EchoControls" IsEnabled="False">
        <Grid>
         <TextBlock Text="BLOOD ECHOES" Style="{StaticResource Caption}" />
         <TextBlock x:Name="EchoValue" Text="—" HorizontalAlignment="Right" Foreground="#D0B179" FontWeight="SemiBold" />
        </Grid>
        <Grid Margin="0,10,0,0">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
         </Grid.ColumnDefinitions>
         <TextBox x:Name="EchoInput" Text="100000" Margin="0,0,10,0" AutomationProperties.Name="Blood Echoes amount" />
         <Button Grid.Column="1" Content="Set echoes" Click="SetEchoes" Style="{StaticResource Primary}" Margin="0,0,10,0" />
         <Button Grid.Column="2" Content="+10,000" Click="AddEchoes" />
        </Grid>
        <TextBlock Text="0–999,999,999 · Changes the current balance. The game may save this value." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" />
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,18">
       <StackPanel x:Name="StatControls" IsEnabled="False">
        <Grid>
         <StackPanel>
          <TextBlock Text="CHARACTER ATTRIBUTES" Style="{StaticResource Caption}" />
          <TextBlock x:Name="LevelValue" Text="Blood Level —" FontSize="20" />
         </StackPanel>
         <Button Content="Reload current" Click="LoadStats" HorizontalAlignment="Right" VerticalAlignment="Top" />
        </Grid>
        <UniformGrid Columns="3" Margin="0,20,0,0">
         <StackPanel Margin="0,0,12,16">
          <TextBlock Text="Vitality" Style="{StaticResource Caption}" />
          <TextBox x:Name="Vitality" AutomationProperties.Name="Vitality" />
         </StackPanel>
         <StackPanel Margin="0,0,12,16">
          <TextBlock Text="Endurance" Style="{StaticResource Caption}" />
          <TextBox x:Name="Endurance" AutomationProperties.Name="Endurance" />
         </StackPanel>
         <StackPanel Margin="0,0,0,16">
          <TextBlock Text="Strength" Style="{StaticResource Caption}" />
          <TextBox x:Name="Strength" AutomationProperties.Name="Strength" />
         </StackPanel>
         <StackPanel Margin="0,0,12,0">
          <TextBlock Text="Skill" Style="{StaticResource Caption}" />
          <TextBox x:Name="Skill" AutomationProperties.Name="Skill" />
         </StackPanel>
         <StackPanel Margin="0,0,12,0">
          <TextBlock Text="Bloodtinge" Style="{StaticResource Caption}" />
          <TextBox x:Name="Bloodtinge" AutomationProperties.Name="Bloodtinge" />
         </StackPanel>
         <StackPanel>
          <TextBlock Text="Arcane" Style="{StaticResource Caption}" />
          <TextBox x:Name="Arcane" AutomationProperties.Name="Arcane" />
         </StackPanel>
        </UniformGrid>
        <TextBlock Text="1–99 per attribute. Blood Level follows the attribute change. Apply while idle, then quit to title and reload your character to refresh derived stats." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,18,0,16" />
        <Button Content="Apply attributes" Click="ApplyStats" Style="{StaticResource Primary}" HorizontalAlignment="Left" />
       </StackPanel>
      </Border>
     </StackPanel>
     <StackPanel x:Name="PracticePage" Visibility="Collapsed">
      <TabControl x:Name="PracticeSections">
       <TabItem Header="Controls">
        <Border Style="{StaticResource Card}">
         <StackPanel x:Name="PracticeControls" IsEnabled="False">
          <TextBlock Text="COMBAT &amp; STEALTH" Style="{StaticResource Caption}" />
          <UniformGrid Columns="2">
           <StackPanel>
            <CheckBox x:Name="GodMode" Content="God mode" Tag="GodMode" Checked="FlagChanged" Unchecked="FlagChanged" />
            <CheckBox x:Name="IgnoreHits" Content="Ignore hits" Tag="NoHitReaction" Margin="18,0,0,4" ToolTip="Native invincibility: avoid normal attack hits and reactions. Scripted events and grabs need live testing." Checked="FlagChanged" Unchecked="FlagChanged" />
           </StackPanel>
           <CheckBox x:Name="OneShot" Content="One-shot kills" Tag="OneShot" Checked="FlagChanged" Unchecked="FlagChanged" />
           <CheckBox x:Name="Stealth" Content="Invisible to enemies" Tag="Stealth" Checked="FlagChanged" Unchecked="FlagChanged" />
           <CheckBox x:Name="Silent" Content="Silent footsteps" Tag="Silence" Checked="FlagChanged" Unchecked="FlagChanged" />
           <CheckBox x:Name="NoAi" Content="Disable enemy AI" Tag="NoAi" Checked="FlagChanged" Unchecked="FlagChanged" />
           <CheckBox x:Name="NoFallDamage" Content="No fall damage" Tag="NoFallDamage" Checked="FlagChanged" Unchecked="FlagChanged" />
           <CheckBox x:Name="InfiniteItems" Content="Infinite consumables &amp; bullets" Tag="InfiniteItems" Checked="FlagChanged" Unchecked="FlagChanged" />
           <CheckBox x:Name="KeepEchoesOnDeath" Content="Keep Blood Echoes on death" Tag="NoEchoesLoss" ToolTip="Uses the native death-penalty skip flag. Does not refill Echoes or prevent spending. Live death/bloodstain testing pending." Checked="FlagChanged" Unchecked="FlagChanged" />
          </UniformGrid>
          <StackPanel Margin="0">
           <TextBlock Text="PLAYER MULTIPLIERS" Style="{StaticResource Caption}" />
           <UniformGrid Columns="2" Margin="0,8,0,12">
            <StackPanel Margin="0,0,12,0">
             <TextBlock Text="Outgoing damage" Style="{StaticResource Caption}" />
             <TextBox x:Name="DamageMultiplier" Text="1" AutomationProperties.Name="Damage multiplier" />
            </StackPanel>
            <StackPanel>
             <TextBlock Text="Echoes from enemies" Style="{StaticResource Caption}" />
             <TextBox x:Name="EchoesMultiplier" Text="1" AutomationProperties.Name="Echoes reward multiplier" />
            </StackPanel>
           </UniformGrid>
           <Button Content="Apply multipliers" Click="ApplyMultipliers" HorizontalAlignment="Left" />
           <TextBlock Text="0.1–100×. Set both to 1 to restore. Uses a player-only effect; does not scale spending or bloodstain recovery. Selections resume after loading." Style="{StaticResource Caption}" Margin="0,12,0,12" />
          </StackPanel>
          <TextBlock Text="Selections stay on through loading screens and warps. They resume when the player validates. Disconnecting clears selections; turning them off restores the settings they replaced." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,24,0,16" />
          <Button Content="Turn off practice toggles" Click="TurnOffFeatures" HorizontalAlignment="Left" />
         </StackPanel>
        </Border>
       </TabItem>
       <TabItem Header="Practice" x:Name="ParryTab">
        <Border Style="{StaticResource Card}" IsEnabled="{Binding IsEnabled, ElementName=PracticeControls}">
         <StackPanel Margin="0">
          <WrapPanel>
           <Button Content="Apply practice setup" Click="ApplyParrySetup" Margin="0,0,10,10" />
           <Button Content="Restore previous combat setup" Click="RestoreParrySetup" Margin="0,0,0,10" />
          </WrapPanel>
          <TextBlock Text="Enables protection, infinite bullets/stamina and 0.1× outgoing damage. Turns off one-shot, enemy AI disabling, invisibility and silence so enemies can attack. Leaves Echoes rewards unchanged. Equip a firearm and carry bullets first." Style="{StaticResource Caption}" />
          <CheckBox x:Name="ProtectPracticeEnemy" Content="Keep practice enemy alive" Checked="EnemyPracticeChanged" Unchecked="EnemyPracticeChanged" />
          <Button Content="Restore locked enemy HP" Click="RestorePracticeEnemyHealth" HorizontalAlignment="Left" Margin="0,12,0,0" />
          <TextBlock x:Name="ParrySummary" Text="Lock onto a living enemy before enabling target protection or restoring its health." Foreground="#D0B179" Margin="0,12,0,0" />
          <TextBlock Text="Target protection allows normal damage and reactions, preventing ordinary lethal HP damage. Scripted deaths and phase transitions can still occur. Loading/death or an invalid target stops protection; re-enable it deliberately. These target actions are never saved in startup presets." Style="{StaticResource Caption}" Margin="0,12,0,0" />
         </StackPanel>
        </Border>
       </TabItem>
       <TabItem Header="Status" x:Name="StatusTab">
        <Border Style="{StaticResource Card}" IsEnabled="{Binding IsEnabled, ElementName=PracticeControls}">
         <StackPanel Margin="0">
          <TextBlock Text="STATUS BUILDUP" Style="{StaticResource Caption}" />
          <CheckBox x:Name="KeepStatusEmpty" Content="Keep status buildup empty" />
          <Button Content="Cure active slow/rapid poison" Click="CurePoison" HorizontalAlignment="Left" Margin="0,10,0,0" />
          <Button Content="Clear status buildup now" Click="ClearStatusBuildup" HorizontalAlignment="Left" Margin="0,12,0,0" />
          <TextBlock Text="Clears the five buildup gauges while the player validates. Cure poison removes only active slow/rapid poison effects through the native engine. Clear buildup resets meters; neither reverses damage already taken or guarantees one-hit immunity." Style="{StaticResource Caption}" Margin="0,12,0,16" />
         </StackPanel>
        </Border>
       </TabItem>
       <TabItem Header="Weapons" x:Name="DurabilityTab">
        <Border Style="{StaticResource Card}" IsEnabled="{Binding IsEnabled, ElementName=PracticeControls}">
         <StackPanel Margin="0">
          <TextBlock Text="WEAPON DURABILITY" Style="{StaticResource Caption}" />
          <CheckBox x:Name="KeepDurability" Content="Keep equipped weapons at full durability" Checked="DurabilityToggled" Unchecked="DurabilityToggled" />
          <CheckBox x:Name="AutoRepair" Content="Auto-repair equipped weapons below threshold" Checked="DurabilityToggled" Unchecked="DurabilityToggled" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
           <TextBlock Text="Threshold %" VerticalAlignment="Center" Margin="0,0,10,0" />
           <TextBox x:Name="RepairThreshold" Text="30" Width="80" AutomationProperties.Name="Repair threshold percent" />
          </StackPanel>
          <Button Content="Repair equipped weapons now" Click="RepairWeapons" HorizontalAlignment="Left" Margin="0,12,0,0" />
          <TextBlock x:Name="DurabilitySummary" Text="Repair uses the native equipped-weapon routine. Results for each slot appear here." TextWrapping="Wrap" Foreground="#D0B179" Margin="0,10,0,0" />
          <TextBlock Text="Refills equipped weapon durability while the character validates. Full-durability mode takes priority over the threshold. Disabling resumes normal wear; repairs can be saved by the game." Style="{StaticResource Caption}" Margin="0,12,0,16" />
         </StackPanel>
        </Border>
       </TabItem>
       <TabItem Header="Presets" x:Name="PresetsTab">
        <Border Style="{StaticResource Card}">
         <StackPanel Margin="0">
          <TextBlock Text="Group" Style="{StaticResource Caption}" />
          <TextBox x:Name="PresetGroup" Text="General" MaxLength="80" AutomationProperties.Name="Preset group" Margin="0,0,0,10" />
          <TextBox x:Name="PresetName" Text="My practice setup" MaxLength="80" AutomationProperties.Name="Preset name" />
          <Button Content="Save current settings" Click="SavePreset" HorizontalAlignment="Left" Margin="0,10,0,16" />
          <TextBox x:Name="PresetSearch" TextChanged="SearchPresets" AutomationProperties.Name="Search presets by name or group" ToolTip="Search presets by name or group" Margin="0" Visibility="Collapsed" />
          <ComboBox x:Name="PresetPicker" MinHeight="40" AutomationProperties.Name="Saved practice preset" local:PickerSearch.Target="PresetSearch" />
