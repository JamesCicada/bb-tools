    <Compile Include="../BBTools/DiscordGameDetails.cs" Link="Shared/DiscordGameDetails.cs" />
    <Compile Include="../BBTools/DiscordPresence.cs" Link="Shared/DiscordPresence.cs" />
    <Compile Include="../BBTools/EncounterTimer.cs" Link="Shared/EncounterTimer.cs" />
